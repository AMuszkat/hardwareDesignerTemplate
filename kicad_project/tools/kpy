#!/usr/bin/env bash
# Run a script with the Python interpreter that can `import pcbnew`.
#
#     tools/kpy tools/place/place.py check --board board1_main plan.json
#
# KiCad's pcbnew module is built for ONE interpreter (on Linux the system
# /usr/bin/python3; on macOS the Python inside KiCad.app). A venv or conda
# python cannot import it. `./setup.sh init` finds that interpreter and records
# it as "kicad_python" in kicad_project/local.json (per machine, gitignored);
# KICAD_PYTHON overrides.
set -euo pipefail
here="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
cfg="$here/../local.json"
py="${KICAD_PYTHON:-}"
if [ -z "$py" ] && [ -f "$cfg" ]; then
  py="$(sed -n 's/.*"kicad_python"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' "$cfg" | head -1)"
fi
py="${py:-/usr/bin/python3}"
if [ ! -x "$py" ]; then
  echo "tools/kpy: $py is not an executable Python." >&2
  echo "Set kicad_python in kicad_project/local.json (./setup.sh init does it) or export KICAD_PYTHON." >&2
  exit 1
fi
# No trial import here (it would load pcbnew twice on every call): each tool
# reports a missing pcbnew itself, and tools/setup.sh tests the interpreter once.
exec "$py" "$@"
